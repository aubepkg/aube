amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Builtins.pkl"

local vendoredBats = List(
    "test/bats/**",
    "test/test_helper/bats-assert/**",
    "test/test_helper/bats-file/**",
    "test/test_helper/bats-support/**",
)

exclude = vendoredBats

local linters = new Mapping<String, Step> {
    ["cargo-fmt"] = Builtins.cargo_fmt
    ["cargo-clippy"] = (Builtins.cargo_clippy) {
        check = new CommandSpec {
            command = "cargo clippy --manifest-path {{workspace_indicator}} --quiet -- -D warnings"
            effect = "write"
        }
    }
    // the builtin already covers *.bats
    ["shfmt"] = Builtins.shfmt
    // the builtin covers *.sh, *.bash, and shell shebangs; add the bats tests
    ["shellcheck"] = (Builtins.shellcheck) {
        match_any = List(
            new FileSelector { glob = List("**/*.bats", "**/*.sh", "**/*.bash") },
            new FileSelector { types = List("sh", "bash") },
        )
    }
    // lints GitHub Actions workflows, composite actions and Dependabot config (jdx/jactionlint)
    ["jactionlint"] {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml", "action.yml", "action.yaml", ".github/actions/**/action.yml", ".github/actions/**/action.yaml", ".github/dependabot.yml", ".github/dependabot.yaml")
        batch = true
        check = new CommandSpec {
            command = "jactionlint {{files}}"
            effect = "read"
        }
        fix = new CommandSpec {
            command = "jactionlint --fix {{files}}"
            effect = "write"
        }
    }
    ["pkl"] {
        glob = "*.pkl"
        check = new CommandSpec {
            command = "pkl eval {{files}} >/dev/null"
            effect = "read"
        }
    }
}

fail_fast = false

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
