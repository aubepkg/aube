cmd outdated help="Report dependencies whose installed version lags behind the registry" effect=read {
    flag "-D --dev" help="Show only devDependencies" conflicts=--prod
    flag "-g --global" help="Check globally-installed packages instead of the current project." conflicts=--workspace-root
    flag --json help="Emit a JSON object keyed by package name instead of the default table"
    flag --long help="Also show deps whose `wanted` version matches the installed version"
    flag "-P --prod --production" help="Show only production dependencies (skip devDependencies)" conflicts=--dev
    flag "-w --workspace-root --workspace" help="Operate on the workspace root regardless of cwd." {
        long_help "Operate on the workspace root regardless of cwd.\n\nMirrors pnpm's `-w/--workspace-root`: from a sub-package,\n`aube outdated -w` reports the root manifest's deps instead\nof the sub-package's. No-op when paired with `-r` / `--filter`\n(those already drive workspace selection from the root)."
    }
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
