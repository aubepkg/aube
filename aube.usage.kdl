cmd trust help="Inspect npm package publishing trust" effect=read subcommand_required=#true {
    cmd check help="Check one package version for a publishing-trust downgrade" effect=read {
        after_long_help "Examples:\n\n  $ aube trust check @hono/node-server@1.19.17\n  @hono/node-server@1.19.17: pass\n  published: 2026-07-27T03:07:48.993Z\n  current evidence: trusted publisher\n  strongest earlier evidence: trusted publisher (2.0.10)\n\n  # Evaluate the underlying policy even when aube has a built-in exception\n  $ aube trust check @hono/node-server@1.19.15 --ignore-default-excludes\n\n  # Machine-readable report\n  $ aube trust check @hono/node-server@1.19.17 --json\n"
        flag --ignore-default-excludes help="Evaluate the policy without aube's built-in package exceptions"
        flag --json help="Emit a JSON report"
        flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
            long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
            arg <N>
        }
        flag --fetch-retry-factor help="Exponential backoff factor between retry attempts." help_heading=Network {
            long_help "Exponential backoff factor between retry attempts.\n\nOverrides `fetchRetryFactor` / `fetch-retry-factor` from\n`.npmrc` / `aube-workspace.yaml` when set. Integer-only — the\nunderlying `FetchPolicy.retry_factor` is `u32`. Fractional\nvalues like `1.5` are rejected by the CLI parser."
            arg <N>
        }
        flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff." help_heading=Network {
            long_help "Upper bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMaxtimeout` / `fetch-retry-maxtimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
            arg <MS>
        }
        flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff." help_heading=Network {
            long_help "Lower bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMintimeout` / `fetch-retry-mintimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
            arg <MS>
        }
        flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
            long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
            arg <MS>
        }
        flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
            long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
            arg <URL>
        }
        arg <PACKAGE@VERSION> help="Exact npm package version to inspect" {
            long_help "Exact npm package version to inspect\n\nExample: `@hono/node-server@1.19.17`."
        }
    }
}
cmd undeprecate help="Clear an existing deprecation on the registry" effect=write {
    flag --dry-run help="Don't PUT anything — print which versions would be touched and exit."
    flag --otp help="One-time password from a 2FA authenticator; sent as `npm-otp`." {
        arg <CODE>
    }
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
        arg <N>
    }
    flag --fetch-retry-factor help="Exponential backoff factor between retry attempts." help_heading=Network {
        long_help "Exponential backoff factor between retry attempts.\n\nOverrides `fetchRetryFactor` / `fetch-retry-factor` from\n`.npmrc` / `aube-workspace.yaml` when set. Integer-only — the\nunderlying `FetchPolicy.retry_factor` is `u32`. Fractional\nvalues like `1.5` are rejected by the CLI parser."
        arg <N>
    }
    flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Upper bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMaxtimeout` / `fetch-retry-maxtimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Lower bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMintimeout` / `fetch-retry-mintimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    arg <PACKAGE> help="Package spec: `name`, `name@version`, or `name@<range>`." {
        long_help "Package spec: `name`, `name@version`, or `name@<range>`.\n\nOmitting the version clears the deprecation on every published\nversion."
    }
}
cmd unlink help="Unlink a package (remove linked entries from node_modules)" effect=write {
    alias dislink
    flag "-g --global" help="Operate on the global link registry instead of the current project." {
        long_help "Operate on the global link registry instead of the current\nproject.\n\n`aube unlink -g` removes the current package's entry from\n`$XDG_CACHE_HOME/aube/global-links`, `$HOME/.cache/aube/global-links`\nwhen `XDG_CACHE_HOME` is unset, or `%LOCALAPPDATA%\\aube\\global-links`\non Windows; `aube unlink -g <name>` removes the named entry."
    }
    arg "[PACKAGE]" help="Package name to unlink (omit to unlink all linked dependencies)"
}
cmd unpublish help="Remove a package (or a single version) from the registry" effect=destructive {
    flag --dry-run help="Don't talk to the registry; print what the command would do."
    flag "-f --force" help="Required for whole-package unpublish (no `@version` in the spec)." {
        long_help "Required for whole-package unpublish (no `@version` in the spec).\n\nSingle-version unpublish works without it — matching npm,\nwhich is more permissive about dropping one version than\nnuking every version in one call."
    }
    flag --otp help="One-time password for registries that require 2FA." {
        long_help "One-time password for registries that require 2FA.\n\nSent verbatim as the `npm-otp` header."
        arg <CODE>
    }
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
        arg <N>
    }
    flag --fetch-retry-factor help="Exponential backoff factor between retry attempts." help_heading=Network {
        long_help "Exponential backoff factor between retry attempts.\n\nOverrides `fetchRetryFactor` / `fetch-retry-factor` from\n`.npmrc` / `aube-workspace.yaml` when set. Integer-only — the\nunderlying `FetchPolicy.retry_factor` is `u32`. Fractional\nvalues like `1.5` are rejected by the CLI parser."
        arg <N>
    }
    flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Upper bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMaxtimeout` / `fetch-retry-maxtimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Lower bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMintimeout` / `fetch-retry-mintimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    arg "[SPEC]" help="Package spec: `name`, `name@version`, or omitted to use the current project's `package.json`." {
        long_help "Package spec: `name`, `name@version`, or omitted to use the\ncurrent project's `package.json`."
    }
}
cmd update help="Update dependencies" effect=write {
    alias up
    alias upgrade
    flag "-D --dev" help="Update only devDependencies." conflicts=--prod
    flag "-E --exact --save-exact" help="Pin manifest specifiers to the resolved version with no range prefix." {
        long_help "Pin manifest specifiers to the resolved version with no range\nprefix.\n\nPair with `--latest`: when the rewritten specifier replaces the\ncaret/tilde original, drop the prefix so the manifest carries an\nexact pin (`\"1.2.3\"`) instead of `\"^1.2.3\"`. Mirrors\n`pnpm update --save-exact`."
    }
    flag "-g --global" help="Update globally installed packages." {
        long_help "Update globally installed packages.\n\nParsed for pnpm compatibility."
    }
    flag "-i --interactive" help="Interactive update picker." {
        long_help "Interactive update picker.\n\nParsed for pnpm compatibility."
    }
    flag "-L --latest" help="Update past the manifest range unless paired with `--no-save`." {
        long_help "Update past the manifest range unless paired with `--no-save`.\n\nRewrites `package.json` specifiers to match the newly resolved\nversions (the registry's `latest` dist-tag, clamped by\n`minimumReleaseAge` / `resolution-mode` as usual). With\n`--no-save`, leaves the manifest range unchanged and resolves\nonly to the newest version that range allows."
    }
    flag "-P --prod --production" help="Update only production dependencies." conflicts=--dev
    flag "-w --workspace" help="Update dependencies in the current workspace package."
    flag --depth help="Dependency traversal depth." {
        long_help "Dependency traversal depth.\n\nParsed for pnpm compatibility but ignored: aube only ever\nrefreshes direct deps (pnpm's `--depth 0` default). Setting\nthe flag emits a one-line warning pointing at\n`rm aube-lock.yaml && aube install` for the\n`--depth Infinity` case."
        arg <DEPTH>
    }
    flag --global-pnpmfile help="Add a global pnpmfile that runs before the local one." conflicts=--ignore-pnpmfile {
        long_help "Add a global pnpmfile that runs before the local one.\n\nMirrors pnpm's `--global-pnpmfile <path>`. The global hook runs\nfirst and the local hook (if any) runs second."
        arg <PATH>
    }
    flag --ignore-pnpmfile help="Skip running `.pnpmfile.mjs` / `.pnpmfile.cjs` hooks for this update."
    flag --ignore-scripts help="Skip lifecycle scripts." hide=#true {
        long_help "Skip lifecycle scripts.\n\nSkips the root `pnpm:devPreinstall` hook and all approved\ndependency build scripts in the chained install."
    }
    flag --lockfile-only help="Refresh the lockfile without populating `node_modules`." {
        long_help "Refresh the lockfile without populating `node_modules`.\n\nRe-resolves the full graph (direct + transitive) and writes\n`aube-lock.yaml`, then skips the linker so `node_modules` is\nleft untouched. Mirrors `npm update --package-lock-only`."
    }
    flag --no-optional help="Skip optionalDependencies."
    flag --no-save help="Refresh the lockfile without rewriting `package.json` ranges." {
        long_help "Refresh the lockfile without rewriting `package.json` ranges.\n\nPair with `--latest` to refresh the lockfile to the newest\nversion allowed by the unchanged manifest range. Without\n`--latest`, it still suppresses manifest range rewrites enabled\nby `updateRewritesSpecifier`. Mirrors `pnpm update --no-save`."
    }
    flag --pnpmfile help="Override the local pnpmfile location." conflicts=--ignore-pnpmfile {
        long_help "Override the local pnpmfile location.\n\nMirrors pnpm's `--pnpmfile <path>`. Relative paths resolve\nagainst the project root; absolute paths are used as-is. Wins\nover `pnpmfilePath` from `pnpm-workspace.yaml`."
        arg <PATH>
    }
    flag --frozen-lockfile help="Error if the lockfile drifts from package.json." help_heading=Lockfile {
        conflicts --no-frozen-lockfile --prefer-frozen-lockfile
    }
    flag --no-frozen-lockfile help="Always re-resolve, even if the lockfile is up to date." help_heading=Lockfile {
        conflicts --frozen-lockfile --prefer-frozen-lockfile
    }
    flag --prefer-frozen-lockfile help="Use the lockfile when fresh, re-resolve when stale." help_heading=Lockfile {
        conflicts --frozen-lockfile --no-frozen-lockfile
    }
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
        arg <N>
    }
    flag --fetch-retry-factor help="Exponential backoff factor between retry attempts." help_heading=Network {
        long_help "Exponential backoff factor between retry attempts.\n\nOverrides `fetchRetryFactor` / `fetch-retry-factor` from\n`.npmrc` / `aube-workspace.yaml` when set. Integer-only — the\nunderlying `FetchPolicy.retry_factor` is `u32`. Fractional\nvalues like `1.5` are rejected by the CLI parser."
        arg <N>
    }
    flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Upper bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMaxtimeout` / `fetch-retry-maxtimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Lower bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMintimeout` / `fetch-retry-mintimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    flag "--disable-global-virtual-store --disable-gvs" help="Force the shared global virtual store off for this invocation." help_heading="Virtual store" conflicts=--enable-global-virtual-store {
        long_help "Force the shared global virtual store off for this invocation.\n\nPackages are materialized inside the project's virtual store\ninstead of symlinked from `~/.cache/aube/virtual-store/`."
    }
    flag "--enable-global-virtual-store --enable-gvs" help="Force the shared global virtual store on for this invocation." help_heading="Virtual store" conflicts=--disable-global-virtual-store {
        long_help "Force the shared global virtual store on for this invocation.\n\nOverrides CI's default per-project materialization and the\n`disableGlobalVirtualStoreForPackages` auto-disable heuristic."
    }
    arg "[PACKAGES]..." help="Package(s) to update (all if empty)"
}
cmd version help="Bump the version in package.json (and optionally create a git commit + tag)" effect=write {
    flag --allow-same-version help="Allow setting the version to its current value without erroring."
    flag --ignore-scripts help="Skip `preversion` / `version` / `postversion` lifecycle scripts."
    flag --json help="Emit the result as JSON instead of `v<version>` text."
    flag "-m --message" help="Commit message template." {
        long_help "Commit message template.\n\n`%s` is replaced with the new version. Defaults to `v%s`."
        arg <MSG>
    }
    flag --no-commit-hooks help="Skip git pre-commit / commit-msg hooks (passes `--no-verify`)."
    flag --no-git-tag-version help="Don't create a git commit or tag." {
        long_help "Don't create a git commit or tag.\n\nBy default `aube version` commits the manifest change and\ntags it `v<version>`."
    }
    flag --preid help="Prerelease identifier to use with the `pre*` keywords (e.g. `rc`)." {
        arg <ID>
    }
    flag --sign-git-tag help="GPG-sign the created tag (`git tag -s`)."
    arg "[NEW_VERSION]" help="Bump keyword or an explicit version string." {
        long_help "Bump keyword or an explicit version string.\n\nAccepts `major`, `minor`, `patch`, `premajor`, `preminor`,\n`prepatch`, `prerelease`, `from-git`, or an explicit version.\n`from-git` reads the nearest reachable version-like Git tag.\nWhen omitted, prints the current version."
    }
}
cmd view help="Print package metadata from the registry" effect=read {
    alias info
    alias show
    alias v
    after_long_help "Examples:\n\n  $ aube view\n  my-package@1.0.0 | MIT | deps: 0 | versions: 1\n\n  $ aube view react\n  react@18.3.1 | MIT | deps: 1 | versions: 2037\n  React is a JavaScript library for building user interfaces.\n  https://react.dev/\n\n  keywords: react\n\n  dist\n  .tarball: https://registry.npmjs.org/react/-/react-18.3.1.tgz\n  .shasum:  a0b2eb79...\n  .integrity: sha512-...\n\n  # A specific version\n  $ aube view react@17.0.2\n\n  # A single field\n  $ aube view react version\n  18.3.1\n\n  $ aube view react dist.tarball\n  https://registry.npmjs.org/react/-/react-18.3.1.tgz\n\n  # All versions ever published\n  $ aube view react versions --json\n\n  # Raw JSON for the resolved version\n  $ aube view react@next --json\n"
    flag --json help="Print the full JSON of the selected version instead of the summary." {
        long_help "Print the full JSON of the selected version instead of the summary.\n\nMutually exclusive with `field`."
    }
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
        arg <N>
    }
    flag --fetch-retry-factor help="Exponential backoff factor between retry attempts." help_heading=Network {
        long_help "Exponential backoff factor between retry attempts.\n\nOverrides `fetchRetryFactor` / `fetch-retry-factor` from\n`.npmrc` / `aube-workspace.yaml` when set. Integer-only — the\nunderlying `FetchPolicy.retry_factor` is `u32`. Fractional\nvalues like `1.5` are rejected by the CLI parser."
        arg <N>
    }
    flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Upper bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMaxtimeout` / `fetch-retry-maxtimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Lower bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMintimeout` / `fetch-retry-mintimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    arg "[PACKAGE]" help="Package to view, optionally with a version or dist-tag." {
        long_help "Package to view, optionally with a version or dist-tag.\n\nExamples: `lodash`, `lodash@4.17.21`, `react@next`, `express@^4`."
    }
    arg "[FIELD]" help="Dotted path into the version metadata to print." {
        long_help "Dotted path into the version metadata to print.\n\nExamples: `version`, `dependencies`, `dist.tarball`,\n`maintainers.0.name`. When omitted, prints a formatted summary."
    }
}
cmd whoami help="Report the current registry user (not implemented — use `npm whoami`)" hide=#true effect=read {
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
        arg <N>
    }
    flag --fetch-retry-factor help="Exponential backoff factor between retry attempts." help_heading=Network {
        long_help "Exponential backoff factor between retry attempts.\n\nOverrides `fetchRetryFactor` / `fetch-retry-factor` from\n`.npmrc` / `aube-workspace.yaml` when set. Integer-only — the\nunderlying `FetchPolicy.retry_factor` is `u32`. Fractional\nvalues like `1.5` are rejected by the CLI parser."
        arg <N>
    }
    flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Upper bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMaxtimeout` / `fetch-retry-maxtimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Lower bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMintimeout` / `fetch-retry-mintimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    arg "[ARGS]..." help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints." hide=#true double_dash=automatic {
        long_help "Unused; captured so `aube <cmd> foo bar` parses instead of\nerroring on unexpected args before the fallback message prints."
    }
}
cmd why help="Print reverse dependency chains explaining why a package is installed" effect=read {
    alias w
    after_long_help "Examples:\n\n  $ aube why debug\n  my-app@1.0.0 /home/user/project\n\n  dependencies:\n  express 4.19.2\n  └── debug 2.6.9\n  body-parser 1.20.2\n  └── debug 2.6.9\n\n  # Only follow chains starting at a devDependency\n  $ aube why --dev typescript\n\n  # Include each node's store path\n  $ aube why --long debug\n\n  # Tab-separated, one chain per line (pipe-friendly)\n  $ aube why --parseable debug\n\n  # JSON: an array of chain objects\n  $ aube why --json debug\n"
    flag "-D --dev" help="Only follow chains that start at a devDependency" conflicts=--prod
    flag "-P --prod --production" help="Only follow chains that start at a production (or optional) dependency" conflicts=--dev
    flag --json help="Output as JSON — an array of chain objects" conflicts=--parseable
    flag --long help="Append each node's `.aube/<dep_path>` store path to the tree output"
    flag --parseable help="Tab-separated output: one line per chain, `importer\\tdep_type\\tname@ver\\t...`"
    arg <PACKAGE> help="Package name to search for (exact match against package names)"
}

// Route external usage consumers to the compiled completer used by the
// built-in scripts. The complete argv is preserved, including `-C`.
complete "script" run="aube __complete_word__ --candidates script --line={{ words | shell_join | shell_quote }}"

// Keep value completers in a shared fragment so `aube usage`, `aubr`, and
// `aubx` are generated from the same candidate protocol.
// Let external usage consumers ask the same compiled completers as the
// built-in scripts. shell_join preserves argv boundaries; shell_quote carries
// the reconstructed line through sh -c as one inert --line value.
complete "package" run="aube __complete_word__ --candidates package --line={{ words | shell_join | shell_quote }}"
complete "packages" run="aube __complete_word__ --candidates packages --line={{ words | shell_join | shell_quote }}"
complete "pkg" run="aube __complete_word__ --candidates pkg --line={{ words | shell_join | shell_quote }}"
complete "bin" run="aube __complete_word__ --candidates bin --line={{ words | shell_join | shell_quote }}"
complete "workspace" run="aube __complete_word__ --candidates workspace --line={{ words | shell_join | shell_quote }}"
complete "key" run="aube __complete_word__ --candidates key --line={{ words | shell_join | shell_quote }}"
complete "patch" run="aube __complete_word__ --candidates patch --line={{ words | shell_join | shell_quote }}"
complete "dir" type="dir"
complete "path" type="path"
