        arg <MS>
    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    arg "[ARGS]..." help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints." hide=#true double_dash=automatic {
        long_help "Unused; captured so `aube <cmd> foo bar` parses instead of\nerroring on unexpected args before the fallback message prints."
    }
}
cmd set help="Alias for `config set` (hidden; prefer `config set`)" hide=#true effect=write {
    flag --local help="Shortcut for `--location project`." conflicts=--location
    flag --location help="Which config location to write to." default=user {
        long_help "Which config location to write to.\n\nDefaults to `user`. Writes land in `.npmrc` for the npm-shared\nsurface — per-host auth/cert templates, scoped registries, and\nsettings tagged `npmShared = true` in the settings registry\n(`registry`, `proxy` / `https-proxy`, `engine-strict`,\n`ignore-scripts`, etc.) — so npm and yarn read the same value.\nAube-only and pnpm-only settings, plus unknown keys, land in\naube's own config (`~/.config/aube/config.toml` at user scope,\n`<cwd>/.config/aube/config.toml` at project scope) where\nsibling tools don't see them.\n\nDotted writes for aube map settings (`allowBuilds.<pkg>`,\n`overrides.<pkg>`, …) edit one entry at a time. At project\nscope (`--local`) they land in\n`pnpm-workspace.yaml#<map>.<entry>` or\n`package.json#aube.<map>.<entry>` if no workspace yaml exists,\nthe same place install reads from. User-scope dotted writes\nfor these maps error: aube only reads them per project."
        arg <LOCATION> {
            choices {
                choice user help="User config (`~/.config/aube/config.toml` for known aube settings, `~/.npmrc` for registry/auth and unknown keys)"
                choice project help="`<cwd>/.npmrc`"
                choice global help="Alias for `user` — aube has no separate global config file."
            }
        }
    }
    arg <KEY> help="Setting key (canonical name or `.npmrc` alias)."
    arg <VALUE> help="Value to write. Stored verbatim after `key=`."
}
