    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    arg "[ARGS]..." help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints." hide=#true double_dash=automatic {
        long_help "Unused; captured so `aube <cmd> foo bar` parses instead of\nerroring on unexpected args before the fallback message prints."
    }
}
cmd prefix help="Print the current package prefix directory" effect=read {
    flag "-g --global" help="Print the global prefix directory instead of the project's root"
}
cmd prune help="Remove extraneous packages from project `node_modules`." effect=write {
    long_help "Remove extraneous packages from project `node_modules`.\n\nReads the lockfile, computes the packages still reachable from each\nimporter, and removes stale top-level links, stale virtual-store entries,\nand dangling .bin links. Does not modify package.json or the lockfile."
    flag "-P --prod --production" help="Remove devDependencies from node_modules"
    flag --no-optional help="Also remove optionalDependencies"
}
cmd publish help="Publish the current package to the registry" effect=write {
    flag --access help="Publish as `public` or `restricted`." {
        long_help "Publish as `public` or `restricted`.\n\nSent as the `access` field in the publish body; scoped\npackages default to `restricted` on the registry side, so\npass `--access=public` to make a new scoped package\nworld-readable."
        arg <LEVEL>
    }
    flag --dry-run help="Don't upload; print what would be published."
    flag --force help="Republish even when the version is already on the registry." {
        long_help "Republish even when the version is already on the registry.\n\nBy default `aube publish` issues a GET before the PUT and\nrefuses to proceed when the version exists, surfacing a clear\nerror instead of relying on the registry to return 409. In\n`--recursive` / `--filter` mode, `--force` overrides the\nsilent \"already-published\" skip so every selected workspace\npackage is re-PUT. The registry must still accept the\nrepublish — npm's public registry rejects re-publishes\noutright; Verdaccio and most private mirrors allow them."
    }
    flag --ignore-scripts help="Skip publish lifecycle scripts." {
        long_help "Skip publish lifecycle scripts.\n\nSuppresses `prepublishOnly`, `prepublish`, `prepack`, `prepare`,\n`postpack`, `publish`, and `postpublish` scripts for this\npublish."
    }
    flag --json help="Emit the publish result as JSON." {
        long_help "Emit the publish result as JSON.\n\nOutput matches `npm publish --json` / `pnpm publish --json`; recursive multi-package publishes emit an array."
    }
    flag --no-git-checks help="Skip the \"working tree must be clean\" check." {
        long_help "Skip the \"working tree must be clean\" check.\n\nWhen unset, aube refuses to publish from a dirty git checkout\n(uncommitted tracked changes) or from a detached / non-release\nbranch."
    }
    flag --otp help="One-time password for registries that require 2FA." {
        long_help "One-time password for registries that require 2FA.\n\nSent verbatim as the `npm-otp` header."
        arg <CODE>
    }
    flag --provenance help="Generate a SLSA provenance attestation and attach it to the publish body." {
        long_help "Generate a SLSA provenance attestation and attach it to the publish\nbody.\n\nRequires an OIDC-capable CI environment (GitHub Actions with\n`id-token: write`, GitLab CI, Buildkite, or CircleCI) — aube\nsigns via the Sigstore public-good instance (Fulcio + Rekor)\nand attaches the resulting bundle so registries that honor\nnpm's provenance protocol light up the \"provenance\" badge on\nthe published version."
    }
    flag --tag help="Default dist-tag to publish under (default: `latest`)." {
        arg <TAG>
    }
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
        arg <N>
    }
    flag --fetch-retry-factor help="Exponential backoff factor between retry attempts." help_heading=Network {
        long_help "Exponential backoff factor between retry attempts.\n\nOverrides `fetchRetryFactor` / `fetch-retry-factor` from\n`.npmrc` / `aube-workspace.yaml` when set. Integer-only — the\nunderlying `FetchPolicy.retry_factor` is `u32`. Fractional\nvalues like `1.5` are rejected by the CLI parser."
        arg <N>
    }
    flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Upper bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMaxtimeout` / `fetch-retry-maxtimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Lower bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMintimeout` / `fetch-retry-mintimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    arg "[TARBALL|FOLDER]" help="Tarball or package directory to publish (default: current package)."
}
cmd purge help="Alias for `clean` — remove `node_modules` across every workspace project." effect=write {
    long_help "Alias for `clean` — remove `node_modules` across every workspace project.\n\nA `purge` script in the root `package.json` overrides the built-in."
    flag "-l --lockfile" help="Also remove lockfiles at the workspace root." {
        long_help "Also remove lockfiles at the workspace root.\n\nTargets `aube-lock.yaml`, `pnpm-lock.yaml`, `package-lock.json`,\n`npm-shrinkwrap.json`, `yarn.lock`, and `bun.lock`."
    }
}
cmd query help="Query packages in the resolved dependency graph" effect=read {
    flag "-D --dev" help="Only match devDependency roots and their transitive deps." conflicts=--prod
    flag "-P --prod --production" help="Only match production/optional roots and their transitive deps." conflicts=--dev
    flag --json help="Emit a JSON array instead of the default text layout." conflicts=--parseable
    flag --parseable help="Emit tab-separated rows: dep_path, name, version, source, flags."
    arg <SELECTOR> help="Selector expression." {
        long_help "Selector expression.\n\nSupports `*`, bare package names, `[name=value]`,\n`[version=value]`, `[license=value]`, `[depPath=value]`,\n`[source=value]`, `:prod`, `:dev`, `:optional`, `:peer`,\n`:transitive`, `:scripts`, `:bin`, `:deprecated`,\n`:license(value)`, and `:type(value)`."
    }
}
cmd rebuild help="Re-run root lifecycle scripts and allowlisted dependency builds" effect=write {
    alias rb
    long_help "`aube rebuild [<pkg>...]` — without args, re-run the root package's\npreinstall hook, then install / postinstall work for dependency\npackages allowed by the active `allowBuilds` /\n`onlyBuiltDependencies` policy, then the root package's install /\npostinstall / prepare lifecycle hooks.\n\nWith one or more package names, run lifecycle scripts only for the\nnamed deps and skip the root hooks. Match is by graph `name`, which\nis the in-tree alias when one is configured (so `aube rebuild\nmy-alias` works for a manifest entry like\n`\"my-alias\": \"npm:real-pkg@1.0\"`, matching pnpm).\n\nUnlike the other lifecycle shortcuts, `rebuild` intentionally does not\nauto-install: `aube install` already runs these same four hooks after\nlinking, so triggering an install here would double-run every script\non a stale tree. Users who actually want a fresh install should run\n`aube install`."
    arg "[PACKAGE]..." help="Optional package names. When supplied, only matching deps' scripts run; the root lifecycle hooks (preinstall, install, postinstall, prepare) are skipped. Match is by graph `name`, not by `dep_path`. The active `allowBuilds` / `onlyBuiltDependencies` policy is bypassed for the named deps — naming the package is the explicit opt-in." {
        long_help "Optional package names. When supplied, only matching deps'\nscripts run; the root lifecycle hooks (preinstall, install,\npostinstall, prepare) are skipped. Match is by graph `name`,\nnot by `dep_path`. The active `allowBuilds` /\n`onlyBuiltDependencies` policy is bypassed for the named\ndeps — naming the package is the explicit opt-in."
    }
}
cmd recursive help="Run a supported command across workspace packages" {
    alias multi
    alias m
    arg "[ARGS]..." help="Command and arguments to run recursively across workspace packages" double_dash=automatic
}
cmd remove help="Remove a dependency" effect=destructive {
    alias rm
    alias uninstall
    alias un
    alias uni
    flag "-D --save-dev" help="Remove only from devDependencies"
    flag "-g --global" help="Remove from the global install directory instead of the project"
    flag --ignore-scripts help="Skip root lifecycle scripts during the chained reinstall"
    flag "-w --workspace" help="Remove the dependency from the workspace root's `package.json`." conflicts=--global {
        long_help "Remove the dependency from the workspace root's `package.json`.\n\nApplies regardless of the current working directory: walks up\nfrom cwd looking for `aube-workspace.yaml`, `pnpm-workspace.yaml`,\nor a `package.json` with a `workspaces` field and runs the\nremove against that directory. Takes precedence over `--filter`\nwhen both are supplied (same as `add --workspace`)."
    }
    flag --frozen-lockfile help="Error if the lockfile drifts from package.json." help_heading=Lockfile {
        conflicts --no-frozen-lockfile --prefer-frozen-lockfile
    }
    flag --no-frozen-lockfile help="Always re-resolve, even if the lockfile is up to date." help_heading=Lockfile {
        conflicts --frozen-lockfile --prefer-frozen-lockfile
    }
    flag --prefer-frozen-lockfile help="Use the lockfile when fresh, re-resolve when stale." help_heading=Lockfile {
        conflicts --frozen-lockfile --no-frozen-lockfile
    }
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
        arg <N>
    }
    flag --fetch-retry-factor help="Exponential backoff factor between retry attempts." help_heading=Network {
        long_help "Exponential backoff factor between retry attempts.\n\nOverrides `fetchRetryFactor` / `fetch-retry-factor` from\n`.npmrc` / `aube-workspace.yaml` when set. Integer-only — the\nunderlying `FetchPolicy.retry_factor` is `u32`. Fractional\nvalues like `1.5` are rejected by the CLI parser."
        arg <N>
    }
    flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Upper bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMaxtimeout` / `fetch-retry-maxtimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Lower bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMintimeout` / `fetch-retry-mintimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    flag "--disable-global-virtual-store --disable-gvs" help="Force the shared global virtual store off for this invocation." help_heading="Virtual store" conflicts=--enable-global-virtual-store {
        long_help "Force the shared global virtual store off for this invocation.\n\nPackages are materialized inside the project's virtual store\ninstead of symlinked from `~/.cache/aube/virtual-store/`."
    }
    flag "--enable-global-virtual-store --enable-gvs" help="Force the shared global virtual store on for this invocation." help_heading="Virtual store" conflicts=--disable-global-virtual-store {
        long_help "Force the shared global virtual store on for this invocation.\n\nOverrides CI's default per-project materialization and the\n`disableGlobalVirtualStoreForPackages` auto-disable heuristic."
    }
    arg "[PACKAGES]..." help="Package(s) to remove"
}
cmd restart help="Restart a package (shortcut for `run restart`; falls back to `stop` + `start`)" {
    flag --no-install help="Skip auto-install check"
    flag --frozen-lockfile help="Error if the lockfile drifts from package.json." help_heading=Lockfile {
        conflicts --no-frozen-lockfile --prefer-frozen-lockfile
    }
    flag --no-frozen-lockfile help="Always re-resolve, even if the lockfile is up to date." help_heading=Lockfile {
        conflicts --frozen-lockfile --prefer-frozen-lockfile
    }
    flag --prefer-frozen-lockfile help="Use the lockfile when fresh, re-resolve when stale." help_heading=Lockfile {
        conflicts --frozen-lockfile --no-frozen-lockfile
    }
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
        arg <N>
    }
    flag --fetch-retry-factor help="Exponential backoff factor between retry attempts." help_heading=Network {
        long_help "Exponential backoff factor between retry attempts.\n\nOverrides `fetchRetryFactor` / `fetch-retry-factor` from\n`.npmrc` / `aube-workspace.yaml` when set. Integer-only — the\nunderlying `FetchPolicy.retry_factor` is `u32`. Fractional\nvalues like `1.5` are rejected by the CLI parser."
        arg <N>
    }
    flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Upper bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMaxtimeout` / `fetch-retry-maxtimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Lower bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMintimeout` / `fetch-retry-mintimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    flag "--disable-global-virtual-store --disable-gvs" help="Force the shared global virtual store off for this invocation." help_heading="Virtual store" conflicts=--enable-global-virtual-store {
        long_help "Force the shared global virtual store off for this invocation.\n\nPackages are materialized inside the project's virtual store\ninstead of symlinked from `~/.cache/aube/virtual-store/`."
    }
    flag "--enable-global-virtual-store --enable-gvs" help="Force the shared global virtual store on for this invocation." help_heading="Virtual store" conflicts=--disable-global-virtual-store {
        long_help "Force the shared global virtual store on for this invocation.\n\nOverrides CI's default per-project materialization and the\n`disableGlobalVirtualStoreForPackages` auto-disable heuristic."
    }
    arg "[ARGS]..." help="Arguments to pass to the script" double_dash=automatic
}
cmd root help="Print the path to `node_modules`" effect=read {
    flag "-g --global" help="Print the global package directory instead of the project's"
}
cmd run help="Run a script defined in package.json" {
    alias run-script
    flag --complete help="Print the nearest `package.json`'s scripts for shell completion." hide=#true {
        long_help "Print the nearest `package.json`'s scripts for shell completion.\n\nConsumed by the `complete \"script\"` node in the usage spec, not\nmeant to be typed by hand."
    }
    flag --if-present help="Don't error if the script is missing from package.json"
    flag --inspect help="Forward `--inspect` to a Node-backed script or local binary." require_equals=#true value_optional=#true default_missing="" {
        arg "[[[HOST:]PORT]]" required=#false
    }
    flag --inspect-brk help="Forward `--inspect-brk` to a Node-backed script or local binary." require_equals=#true value_optional=#true default_missing="" {
        arg "[[[HOST:]PORT]]" required=#false
    }
    flag --no-bail help="Continue recursive execution after a script fails." {
        long_help "Continue recursive execution after a script fails.\n\nParsed for pnpm compatibility; aube's sequential fanout still\nstops on first failure."
    }
    flag --no-install help="Skip auto-install check"
    flag --no-sort help="Disable topological sorting (default is on)." overrides=--sort {
        long_help "Disable topological sorting (default is on).\n\nWithout this, recursive runs visit packages in a deps-first\norder so a `build` script in a shared library finishes before a\ndependent app's `build` starts. Pass this to fall back to the\nraw workspace-listing order."
    }
    flag --parallel help="Run the script in every matched workspace package concurrently." {
        long_help "Run the script in every matched workspace package concurrently.\n\nUnbounded parallelism. Pair with `--workspace-concurrency=N` to\ncap the worker count. Single-package runs ignore this flag.\nFirst non-zero exit fails the whole run, but siblings are\nallowed to finish so their output isn't truncated. Child\nstdio is piped and lines are emitted with a `<package>: `\nprefix; pass `--reporter-hide-prefix` to drop the labels."
    }
    flag --report-summary help="Write a recursive run summary file." {
        long_help "Write a recursive run summary file.\n\nParsed for pnpm compatibility."
    }
    flag --reporter-hide-prefix help="Hide the `<package>: ` label on parallel-run output lines." {
        long_help "Hide the `<package>: ` label on parallel-run output lines.\n\nLines are still piped through aube (so the line breaks are\nclean even when many packages run at once), but the source\npackage isn't named on each line. Sequential runs ignore this\nflag."
    }
    flag --resume-from help="Resume recursive execution starting at this package name." {
        long_help "Resume recursive execution starting at this package name.\n\nAfter the topo sort and `--reverse` are applied, packages\nbefore the named one in the resulting order are skipped. Errors\nif the name isn't in the matched workspace set."
        arg <PACKAGE>
    }
    flag --reverse help="Reverse the recursive execution order (after topo sort)." {
        long_help "Reverse the recursive execution order (after topo sort).\n\nUseful for teardown-style scripts where dependents must shut\ndown before their deps."
    }
    flag --sort help="Sort recursive packages topologically (this is the default)." overrides=--no-sort {
        long_help "Sort recursive packages topologically (this is the default).\n\nPass to override an earlier `--no-sort` on the same invocation."
    }
    flag -s help="Suppress aube's wrapper output while still showing script stdout/stderr." {
        long_help "Suppress aube's wrapper output while still showing script\nstdout/stderr.\n\nShort alias for the global `--silent` flag; long form is\nintentionally omitted to avoid shadowing the global `--silent`\nin clap's dispatch."
    }
    flag --workspace-concurrency help="Cap the number of recursive packages running at once." {
        long_help "Cap the number of recursive packages running at once.\n\nSetting this implicitly enables parallel mode at width `N`.\n`0` means \"use the available CPU count\". Without this flag,\n`--parallel` stays unbounded."
        arg <N>
    }
    flag --frozen-lockfile help="Error if the lockfile drifts from package.json." help_heading=Lockfile {
        conflicts --no-frozen-lockfile --prefer-frozen-lockfile
    }
    flag --no-frozen-lockfile help="Always re-resolve, even if the lockfile is up to date." help_heading=Lockfile {
        conflicts --frozen-lockfile --prefer-frozen-lockfile
    }
    flag --prefer-frozen-lockfile help="Use the lockfile when fresh, re-resolve when stale." help_heading=Lockfile {
        conflicts --frozen-lockfile --no-frozen-lockfile
    }
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
        arg <N>
    }
    flag --fetch-retry-factor help="Exponential backoff factor between retry attempts." help_heading=Network {
        long_help "Exponential backoff factor between retry attempts.\n\nOverrides `fetchRetryFactor` / `fetch-retry-factor` from\n`.npmrc` / `aube-workspace.yaml` when set. Integer-only — the\nunderlying `FetchPolicy.retry_factor` is `u32`. Fractional\nvalues like `1.5` are rejected by the CLI parser."
        arg <N>
    }
    flag --fetch-retry-maxtimeout help="Upper bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Upper bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMaxtimeout` / `fetch-retry-maxtimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-retry-mintimeout help="Lower bound (ms) on the computed retry backoff." help_heading=Network {
        long_help "Lower bound (ms) on the computed retry backoff.\n\nOverrides `fetchRetryMintimeout` / `fetch-retry-mintimeout` from\n`.npmrc` / `aube-workspace.yaml` when set."
        arg <MS>
    }
    flag --fetch-timeout help="Per-request HTTP timeout in milliseconds." help_heading=Network {
        long_help "Per-request HTTP timeout in milliseconds.\n\nOverrides `fetchTimeout` / `fetch-timeout` from `.npmrc` /\n`aube-workspace.yaml` when set. Applied via `reqwest`'s\n`.timeout()` so it covers headers + body together."
        arg <MS>
    }
    flag --registry help="Override the default registry URL for this invocation." help_heading=Network {
        long_help "Override the default registry URL for this invocation.\n\nUse this npm registry URL for package metadata, tarballs,\naudit requests, dist-tags, and registry writes."
        arg <URL>
    }
    flag "--disable-global-virtual-store --disable-gvs" help="Force the shared global virtual store off for this invocation." help_heading="Virtual store" conflicts=--enable-global-virtual-store {
        long_help "Force the shared global virtual store off for this invocation.\n\nPackages are materialized inside the project's virtual store\ninstead of symlinked from `~/.cache/aube/virtual-store/`."
    }
    flag "--enable-global-virtual-store --enable-gvs" help="Force the shared global virtual store on for this invocation." help_heading="Virtual store" conflicts=--disable-global-virtual-store {
        long_help "Force the shared global virtual store on for this invocation.\n\nOverrides CI's default per-project materialization and the\n`disableGlobalVirtualStoreForPackages` auto-disable heuristic."
    }
    arg "[SCRIPT]" help="Script or local binary name." {
        long_help "Script or local binary name.\n\nOmit on an interactive TTY to pick from `package.json`\nscripts. If no script matches, aube falls back to\n`node_modules/.bin/<name>`."
    }
    arg "[ARGS]..." help="Arguments to pass to the script" double_dash=automatic
}
cmd runtime help="Manage the project's Node.js runtime (pin, install, inspect)" effect=read subcommand_required=#true {
    alias rt
    cmd list help="Show the resolved runtime and installed versions" effect=read {
        alias ls
    }
    cmd set help="Pin a runtime in package.json devEngines.runtime and install it" effect=write {
        flag "-g --global" help="Install for the user instead of the project (delegates to `mise use -g node@<version>` when mise manages installs)" {
            long_help "Install for the user instead of the project (delegates to\n`mise use -g node@<version>` when mise manages installs)"
        }
        flag --on-fail help="`onFail` policy written to devEngines.runtime" default=download {
            arg <POLICY>
        }
        flag --save-exact help="Pin the exact resolved version instead of a caret range"
        arg <NAME> help="Runtime name (only `node` is supported)"
        arg <VERSION> help="Version request: an exact version, a range (`^24`, `22`), `lts`, `latest`, or an LTS codename (`lts/jod`)" {
            long_help "Version request: an exact version, a range (`^24`, `22`), `lts`,\n`latest`, or an LTS codename (`lts/jod`)"
        }
    }
}
cmd sbom help="Generate a Software Bill of Materials (CycloneDX or SPDX)" effect=read {
    flag "-D --dev" help="Show only devDependencies" conflicts=--prod
    flag --exclude-peers help="Exclude peer dependencies from CycloneDX output"
    flag --format help="Output format: `cyclonedx` (default) or `spdx`" default=cyclonedx {
        arg <FORMAT> {
            choices {
                choice cyclonedx
                choice spdx
            }
        }
    }
    flag --lockfile-only help="Describe the complete platform-independent lockfile graph"
    flag "-P --prod --production" help="Show only production dependencies (skip devDependencies)" conflicts=--dev
}
cmd search help="Search the registry for packages (not implemented — use `npm search`)" hide=#true effect=read {
    flag --fetch-retries help="Number of retry attempts for failed registry fetches." help_heading=Network {
        long_help "Number of retry attempts for failed registry fetches.\n\nOverrides `fetchRetries` / `fetch-retries` from `.npmrc` /\n`aube-workspace.yaml` when set. Pair with `--fetch-timeout` to\nfail fast in scripted test runs."
